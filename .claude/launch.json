{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit-app",
      "runtimeExecutable": "venv/Scripts/streamlit.exe",
      "runtimeArgs": ["run", "app/main.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501,
      "autoPort": false
    },
    {
      "name": "public-app",
      "runtimeExecutable": "venv/Scripts/streamlit.exe",
      "runtimeArgs": ["run", "app/public_main.py", "--server.headless", "true", "--server.port", "8502"],
      "port": 8502,
      "autoPort": false
    }
  ]
}
