DATABASE_URL=postgresql://user:password@localhost:5432/recruitment_db
APP_SECRET_KEY=changeme
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Google Drive resume storage (app/services/storage_service.py) ---
# Auth is OAuth 2.0 as the human Google account that OWNS the Drive folder, NOT
# a service account (personal Gmail has no service-account storage quota — an SA
# upload fails 403 storageQuotaExceeded). storage_service.py needs these FOUR at
# runtime:
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token
# ID of the "Recruitment Platform Resumes" Drive folder (one per-job subfolder
# is created lazily beneath it).
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-root-folder-id
#
# Used ONLY by the one-time scripts/authorize_drive_oauth.py — NOT read by
# storage_service.py at runtime. Different lifecycle: the client-secret *file*
# is consumed once to mint GOOGLE_OAUTH_REFRESH_TOKEN above; after that the
# runtime only needs the three already-extracted values, not the file.
GOOGLE_OAUTH_CLIENT_SECRET_FILE=/absolute/path/to/client_secret.json

# Base URL of the public candidate application app (app/public_main.py, run on
# a SEPARATE port from the HR app). The HR Jobs page builds the shareable link
# as  <base>/?token=<token>  (Streamlit 1.62 has no URL path params, so the
# token is a query parameter, not a path segment). Set this to the real public
# host/port once the candidate app is deployed.
#   local dev:  streamlit run app/main.py        --server.port 8501   (HR)
#               streamlit run app/public_main.py  --server.port 8502   (candidates)
APP_PUBLIC_BASE_URL=http://localhost:8502

# Per-task Claude models default to app/ai/claude_client.py's DEFAULT_MODELS
# dict — no env var needed for normal operation. Overrides, most specific wins:
#   1. an explicit model= kwarg (code, not env)
#   2. ANTHROPIC_MODEL_<TASK_NAME> (task_name upper-cased)
#   3. ANTHROPIC_MODEL (global — convenient for a quick manual smoke test of
#      every task at once, but leave it unset for normal use so each task keeps
#      its own cost-appropriate default)
#   4. DEFAULT_MODELS[task_name]
#
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL_JD_ANALYSIS=claude-sonnet-5
# ANTHROPIC_MODEL_RESUME_PARSING=claude-sonnet-5
